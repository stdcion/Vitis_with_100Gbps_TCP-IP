# -----------------------------------------------------------------------------
# device.tcl — параметры платы для Vivado-флоу (bare-metal, без XRT)
#
# ЭТО ШАБЛОН. Не правь сгенерированный build/devices/u200/device.tcl —
# его перезаписывает cmake. Правь этот .in.
#
# Значения приходят из двух источников:
#
#   @FPGA_PART@, @NETWORK_KRNL_MEM@, @CMAC_SLR@  — из CMakeLists.txt (блок
#       FDEV_NAME). Единственный реестр плат в проекте; XRT-флоу берёт их же,
#       поэтому оба флоу не могут разъехаться.
#
#   остальное — задано здесь: это то, чего в CMakeLists нет, потому что в
#       XRT-флоу приходит из шелла платформы (пины, board part, refclk), а в
#       bare-metal взять негде.
# -----------------------------------------------------------------------------

set DEV_NAME        "u200"

# --- чип и board file ---------------------------------------------------------

set DEV_PART        "@FPGA_PART@"

# Board part задаётся строкой: DDR4 IP берёт из него пины и параметры чипа
# памяти. Версия 1.3 — та, что лежит в devices/u200/board_files (извлечена из
# hw.xsa платформы @FNS_PLATFORM@). При обновлении board file поменять и здесь.
set DEV_BOARD_PART  "xilinx.com:au200:part0:1.3"

# Подкаталог внутри board_files/ — на него ссылается сообщение об ошибке, если
# board_part не применился.
set DEV_BOARD_DIR   "au200/1.3"

# --- память для TCP session tables --------------------------------------------

# ddr4 | hbm — определяет, какой IP инстанцируется. Значения "hbm" build_bd.tcl
# сейчас НЕ поддерживает: у HBM другой IP с другими портами, это отдельная
# ветка кода, а не другое значение параметра. Для u280/u50/u55c потребуется
# доработка.
set DEV_MEM_TYPE    "ddr4"

# CMakeLists задаёт банк в нотации v++ (@NETWORK_KRNL_MEM@); board interface
# DDR4 IP называется иначе. Соответствие для u200: DDR[3] -> ddr4_sdram_c3.
# Проверено по board.xml: 16 ГБ, SLR2, тактируется от default_300mhz_clk3.
set DEV_MEM_IF      "ddr4_sdram_c3"
set DEV_MEM_CLK     "default_300mhz_clk3"

# --- CMAC / QSFP --------------------------------------------------------------

# SLR для pblock. Не косметика: GT-квады QSFP физически в этом SLR, и
# размещение ядра в другом ломает timing на GT-путях.
set DEV_CMAC_SLR    "@CMAC_SLR@"

# Какой CMAC-блок и какой GT-квад. Для u200 доступны два (см. комментарий в
# kernel/cmac_krnl/package_cmac_krnl.tcl):
#     CMACE4_X0Y6 -> X1Y48~X1Y51  (QSFP0, нижняя клетка)
#     CMACE4_X0Y7 -> X1Y44~X1Y47  (QSFP1)
# Оба квада в SLR2 — проверено get_slrs на routed-дизайне.
set DEV_CMAC_CORE   "CMACE4_X0Y6"
set DEV_CMAC_QUAD   "X1Y48~X1Y51"

# --- частота ------------------------------------------------------------------

# 170 МГц. Число получено по факту, а не из Makefile: там стоит
# --kernel_frequency 200, но v++ при недоборе тайминга сам снижал до 192.9 МГц,
# то есть 200 никогда не достигались.
#
# Vivado так не делает — он оставляет отрицательный WNS и выдаёт битстрим с
# нарушенным таймингом, который грузится и работает НЕСТАБИЛЬНО. Поэтому здесь
# должна стоять заведомо достижимая частота.
#
# Оценка: на 5 нс получили WNS=-0.616 => предел ~5.62 нс (~178 МГц).
# Критический путь — finalize_ipv4_checksum_32 внутри network_krnl.
# На 5.88 нс (170 МГц) достигалось WNS=+0.123, WHS=+0.0096.
#
# СНИЖЕНО ДО 165 МГц 11.08.2026. Причина: при переводе hls_dual_echo_krnl на
# ap_ctrl_hs (см. пояснение в hls_dual_echo_krnl.cpp) добавился автомат
# управления и регистры прерываний, и на 170 МГц тайминг перестал сходиться:
#     WNS = -0.010 нс, WHS = +0.0024
# Запас на 170 МГц и до этого был тонким: предыдущая сборка дала WNS=+0.0015,
# то есть physopt дотягивал путь до нуля. Добавить логику было уже нельзя.
#
# 165 МГц дают период 6.061 нс, то есть +0.178 нс относительно 170 — в 17 раз
# больше недостачи. Разрешение измерения задержки при этом ухудшается всего на
# 3% (5.882 -> 6.061 нс), что для «пола» в сотни наносекунд несущественно.
#
# ВАЖНО: при изменении этого числа править EPD_CLK_NS в
# scripts/vivado/jtag_ctrl.tcl — иначе пересчёт тактов в наносекунды соврёт.
set DEV_FREQ_MHZ    165.000

# Период для HLS в наносекундах — то же число, обратной величиной.
# Раньше жило отдельно в export_hls_ip.tcl и могло разойтись с clk_wiz.
set DEV_PERIOD_NS   [format %.3f [expr {1000.0 / $DEV_FREQ_MHZ}]]

# --- пути ---------------------------------------------------------------------

# Задаётся относительно каталога устройства; абсолютный путь достраивает
# build_bd.tcl, потому что REPO_ROOT знает только он.
set DEV_PINS_XDC    "pins.xdc"
